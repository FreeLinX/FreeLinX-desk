#!/bin/sh
# FreeLinX Manual Installer (flxinstall)
#
# Boot model: INITRAMFS-PRIMARY, DISK=/HOME.
#   - The entire FreeLinX OS (kernel + full rootfs initramfs) is deployed
#     inside the ESP and booted directly by Limine.
#   - The second disk partition (ext4, LABEL=FLX_HOME) is mounted as
#     persistent /home by the running system (automount/fstab).
#
# bsdinstall-style MANUAL installer, 100% offline, no TUI, no package
# fetching.  Configuration chosen here (language, keyboard, timezone,
# hostname, root/user passwords, WiFi keys) is written into the running
# rootfs *before* the initramfs repack step, so it is baked straight into
# the installed OS image on the ESP.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause

set -e

# --- tiny helpers -----------------------------------------------------------
die() { echo "Error: $*" >&2; exit 1; }

ask_default() {
    # ask_default "prompt" "default" ; echoes entered value (default on empty)
    _p="$1"
    _d="$2"
    printf '%s [%s]: ' "$_p" "$_d"
    read -r _ans || _ans="$_d"
    [ -z "$_ans" ] && _ans="$_d"
    printf '%s\n' "$_ans"
}

menu_select() {
    # menu_select "title" "item1|item2|..."  ; echoes chosen index (1-based)
    # or the entered numeric value after showing the numbered menu.
    _title="$1"
    _menu="$2"
    echo ""
    echo "----------------------------------------------------------"
    echo "  $_title"
    echo "----------------------------------------------------------"
    _i=1
    OLDIFS=$IFS
    IFS='|'
    for _item in $_menu; do
        [ -z "$_item" ] && continue
        if [ $((_i % 2)) -eq 1 ]; then
            printf '  %2d) %-38s' "$_i" "$_item"
        else
            printf '  %2d) %-38s\n' "$_i" "$_item"
        fi
        _i=$((_i + 1))
    done
    IFS=$OLDIFS
    [ $(((_i - 1) % 2)) -eq 1 ] && echo ""
    echo "----------------------------------------------------------"
    printf 'Select a number [1-%d] (Enter = 1): ' "$((_i - 1))"
    read -r _sel || _sel=1
    [ -z "$_sel" ] && _sel=1
    case "$_sel" in
        *[!0-9]*) _sel=1 ;;
    esac
    [ "$_sel" -lt 1 ] 2>/dev/null && _sel=1
    [ "$_sel" -gt $((_i - 1)) ] 2>/dev/null && _sel=1
    printf '%s\n' "$_sel"
}

if [ "$(id -u)" -ne 0 ]; then
    die "flxinstall must be run as root."
fi

# --- optional presets (flxinstall -p file [-y] [disk]) ----------------------
# Presets make the wizard fully non-interactive so the GUI installer and
# automated tests can drive it.  The -p file is a POSIX sh snippet that sets
# any of: LANG_LC KBD_LAYOUT TZ_STR HOSTNAME ROOTPW ROOT_HASH USERNAME
# REALNAME USERPW WIFISSID WIFIPASS DI TARGET_DISK_PRESET
# -y skips the final wipe-confirmation prompt.
FLX_CFG=""
FLX_YES=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -p|--presets) FLX_CFG="$2"; shift 2 ;;
        -y|--yes) FLX_YES=1; shift ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) break ;;
    esac
done
if [ -n "$FLX_CFG" ]; then
    [ -r "$FLX_CFG" ] || die "presets file not readable: $FLX_CFG"
    echo "Using presets from $FLX_CFG (non-interactive)..."
    . "$FLX_CFG"
fi

# days since epoch: used as shadow sp_lstchg so accounts don't look "expired"
SHA_DAYS=$(( $(date +%s) / 86400 ))

# --- locate required utilities ----------------------------------------------
command -v flxpart >/dev/null 2>&1 || die "flxpart utility not found."

MKFS_FAT=""
if command -v mkfs.fat >/dev/null 2>&1; then MKFS_FAT="mkfs.fat"
elif command -v mkfs.vfat >/dev/null 2>&1; then MKFS_FAT="mkfs.vfat"
elif [ -x /sbin/mkfs.fat ]; then MKFS_FAT="/sbin/mkfs.fat"
fi
MKFS_EXT4=""
if command -v mkfs.ext4 >/dev/null 2>&1; then MKFS_EXT4="mkfs.ext4"
elif command -v mke2fs >/dev/null 2>&1; then MKFS_EXT4="mke2fs -t ext4"
elif [ -x /sbin/mke2fs ]; then MKFS_EXT4="/sbin/mke2fs -t ext4"
fi
[ -n "$MKFS_FAT" ] && [ -n "$MKFS_EXT4" ] || die "Filesystem tools (mkfs.fat, mkfs.ext4) not found."

LIMINE_DIR="/usr/share/limine"

# ---------------------------------------------------------------------------
echo ""
echo "=========================================================="
echo "   FreeLinX Installer  (manual, bsdinstall-style)        "
echo "=========================================================="
echo ""
echo " This installer configures your system and writes FreeLinX"
echo " to a disk.  Everything runs offline; no packages will be"
echo " fetched.  You will be asked a few configuration questions"
echo " first (language, keyboard, timezone, users, WiFi), then"
echo " you pick the target disk and confirm the wipe."
echo ""

# --- Step 1: Language -------------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 1/9 - Language"
echo "----------------------------------------------------------"
LANG_CLIST="English (en_US.UTF-8)|German (de_DE.UTF-8)|French (fr_FR.UTF-8)|Spanish (es_ES.UTF-8)|Italian (it_IT.UTF-8)|Portuguese (pt_PT.UTF-8)|Dutch (nl_NL.UTF-8)|Turkish (tr_TR.UTF-8)|Russian (ru_RU.UTF-8)|Arabic (ar_SA.UTF-8)|Persian (fa_IR.UTF-8)|Japanese (ja_JP.UTF-8)|Chinese (zh_CN.UTF-8)"
LANG_LOCALES="en_US.UTF-8|de_DE.UTF-8|fr_FR.UTF-8|es_ES.UTF-8|it_IT.UTF-8|pt_PT.UTF-8|nl_NL.UTF-8|tr_TR.UTF-8|ru_RU.UTF-8|ar_SA.UTF-8|fa_IR.UTF-8|ja_JP.UTF-8|zh_CN.UTF-8"
if [ -z "${LANG_LC:-}" ]; then
    LI=$(menu_select "Choose your language" "$LANG_CLIST")
    LANG_LC=$(echo "$LANG_LOCALES" | cut -d'|' -f"$LI")
fi
LC_LANG=${LANG_LC%.*}   # strip .UTF-8
printf '%s\n' "$LANG_LC" > /etc/flx-locale
echo "  Language set to: $LANG_LC"
echo ""

# --- Step 2: Keyboard -------------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 2/9 - Keyboard layout"
echo "----------------------------------------------------------"
KBD_CLIST="US English (us)|German (de)|French (fr)|British (gb)|Spanish (es)|Italian (it)|Portuguese (pt)|Turkish (tr)|Russian (ru)|Arabic (ar)|Persian (fa)|Japanese (jp)|Custom (enter X layout)"
KBD_LAYOUTS="us|de|fr|gb|es|it|pt|tr|ru|ar|fa|jp|custom"
if [ -z "${KBD_LAYOUT:-}" ]; then
    KI=$(menu_select "Choose your keyboard layout" "$KBD_CLIST")
    KBD_LAYOUT=$(echo "$KBD_LAYOUTS" | cut -d'|' -f"$KI")
    if [ "$KBD_LAYOUT" = "custom" ]; then
        KBD_LAYOUT=$(ask_default "Enter X11 keyboard layout (e.g. us, de, fr, gb)" "us")
    fi
fi
printf '%s\n' "$KBD_LAYOUT" > /etc/flx-kbd
echo "  Keyboard layout: $KBD_LAYOUT"
echo ""

# --- Step 3: Timezone / time ------------------------------------------------
# The image ships without tzdata, so we write a POSIX TZ string
# (works with musl/toybox date via the TZ environment variable).
echo "----------------------------------------------------------"
echo " Step 3/9 - Timezone"
echo "----------------------------------------------------------"
TZ_CLIST="UTC|UTC +1 (Berlin/Paris/Rome)|UTC +2 (Istanbul/Athens)|UTC +3 (Moscow,Nairobi)|UTC +3:30 (Tehran)|UTC +4 (Dubai/Baku)|UTC +5:30 (Mumbai)|UTC +7 (Bangkok/Hanoi)|UTC +8 (Beijing/Singapore)|UTC +9 (Tokyo/Seoul)|UTC -5 (New York)|UTC -6 (Chicago)|UTC -7 (Denver)|UTC -8 (Los Angeles)|UTC +0 - Custom (enter POSIX TZ)"
TZ_POSIX="UTC0|UTC-1|UTC-2|UTC-3|UTC-3:30|UTC-4|UTC-5:30|UTC-7|UTC-8|UTC-9|UTC+5|UTC+6|UTC+7|UTC+8|custom"
if [ -z "${TZ_STR:-}" ]; then
    TI=$(menu_select "Choose your timezone (UTC offset)" "$TZ_CLIST")
    TZ_STR=$(echo "$TZ_POSIX" | cut -d'|' -f"$TI")
    if [ "$TZ_STR" = "custom" ]; then
        TZ_STR=$(ask_default "Enter POSIX TZ string (e.g. 'UTC-1' = UTC+1, 'EST5' = US Eastern)" "UTC0")
    fi
fi
printf '%s\n' "$TZ_STR" > /etc/TZ
export TZ="$TZ_STR"
echo "  Timezone: $TZ_STR  (POSIX TZ)"
echo ""

# --- Step 4: Hostname -------------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 4/9 - Hostname"
echo "----------------------------------------------------------"
if [ -z "${HOSTNAME:-}" ]; then
    HOSTNAME=$(ask_default "Enter system hostname" "freelinx")
fi
printf '%s\n' "$HOSTNAME" > /etc/hostname
hostname "$HOSTNAME" 2>/dev/null || :
echo "  Hostname: $HOSTNAME"
echo ""

# --- Step 5: Root password --------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 5/9 - Root password"
echo "----------------------------------------------------------"
if [ -z "${ROOTPW:-}" ]; then
    echo " (Leave blank to keep the current root password.)"
    printf 'Enter new root password: '
    read -r ROOTPW || ROOTPW=""
fi
if [ -n "$ROOTPW" ]; then
    ROOTHASH="${ROOT_HASH:-}"
    if [ -z "$ROOTHASH" ] && [ -x /sbin/flxhash ]; then
        ROOTHASH=$(flxhash "$ROOTPW" 2>/dev/null)
    fi
    if [ -z "$ROOTHASH" ] && [ -x /bin/python3.12 ]; then
        ROOTHASH=$(/bin/python3.12 -c "import crypt,sys; print(crypt.crypt(sys.argv[1], crypt.mksalt(crypt.METHOD_SHA512)))" "$ROOTPW" 2>/dev/null)
    fi
    # pwhash fallback produces legacy DES hashes that the PAM stack
    # refuses to verify; only use it if nothing stronger is available.
    if [ -z "$ROOTHASH" ] && command -v pwhash >/dev/null 2>&1; then
        ROOTHASH=$(pwhash "$ROOTPW" 2>/dev/null)
    fi
    if [ -n "$ROOTHASH" ]; then
        sed -i "s|^root:.*|root:$ROOTHASH:$SHA_DAYS:0:99999:7:::|" /etc/shadow
        echo "  Root password updated."
    else
        echo "  Warning: no hash tool available; leaving root password unchanged."
    fi
else
    echo "  Keeping current root password."
fi
echo ""

# --- Step 6: User account ---------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 6/9 - User account"
echo "----------------------------------------------------------"
if [ -n "${USERNAME:-}" ]; then
    MAKUSER="y"
else
    printf 'Create a regular user account? (y/N): '
    read -r MAKUSER || MAKUSER="n"
fi
case "$MAKUSER" in
    y|Y|yes|YES)
        if [ -z "${USERNAME:-}" ]; then
            USERNAME=$(ask_default "Enter username (lowercase alnum)" "")
        fi
        if [ -z "$USERNAME" ]; then
            echo "  Skipping user creation (no username entered)."
            USERNAME=""
        else
            # sanitize (keep the trailing newline in the tr set -- a bare
            # `tr -c 'a-z0-9' '_'` would also turn echo's terminating \n
            # into '_' and append a stray underscore to every username)
            USERNAME=$(printf '%s\n' "$USERNAME" | tr -c 'a-z0-9\n' '_')
            if [ -z "${REALNAME:-}" ]; then
                REALNAME=$(ask_default "Enter full name" "$USERNAME")
            fi
            : "${REALNAME:=$USERNAME}"
            if [ -z "${USERPW:-}" ]; then
                printf 'Enter password for %s (blank = disabled): ' "$USERNAME"
                read -r USERPW || USERPW=""
            fi
            USERHASH="!"
            if [ -n "$USERPW" ]; then
                if [ -x /sbin/flxhash ]; then
                    USERHASH=$(flxhash "$USERPW" 2>/dev/null)
                fi
                if [ -z "$USERHASH" ] || [ "$USERHASH" = "!" ]; then
                    if [ -x /bin/python3.12 ]; then
                        USERHASH=$(/bin/python3.12 -c "import crypt,sys; print(crypt.crypt(sys.argv[1], crypt.mksalt(crypt.METHOD_SHA512)))" "$USERPW" 2>/dev/null)
                    fi
                fi
                # pwhash fallback (python3 is gone from the offline image!)
                # emits legacy DES hashes that the PAM stack rejects; keep
                # "!" (locked account) rather than an unusable hash when no
                # stronger generator is available.
                if [ -z "$USERHASH" ] || [ "$USERHASH" = "!" ]; then
                    if command -v pwhash >/dev/null 2>&1; then
                        USERHASH=$(pwhash "$USERPW" 2>/dev/null)
                    fi
                fi
                [ -z "$USERHASH" ] && USERHASH="!"
            fi
            # pick a free UID/GID at/above 1000
            UID_CAND=1000
            while grep -qs "^[^:]*:x:$UID_CAND:" /etc/passwd 2>/dev/null; do
                UID_CAND=$((UID_CAND + 1))
            done
            GID_CAND=$UID_CAND
            while grep -qs "^[^:]*:x:$GID_CAND:" /etc/group 2>/dev/null; do
                GID_CAND=$((GID_CAND + 1))
            done

            # user's own group
            echo "$USERNAME:x:$GID_CAND:" >> /etc/group
            # append to supplemental groups (wheel/video/audio/storage/input/users)
            # with proper comma separation + dedupe.  POSIX sh only.
            for _grp in wheel video audio storage input users; do
                if grep -qs "^$_grp:" /etc/group; then
                    _m=$(grep "^$_grp:" /etc/group | cut -d: -f4 | tr ',' '\n' | sed '/^$/d' | sort -u | tr '\n' ',')
                    _m="${_m%,}"
                    case ",${_m}," in
                        *",$USERNAME,"*) : ;;
                        *)
                            [ -n "$_m" ] && _m="${_m},"
                            _gid=$(grep "^$_grp:" /etc/group | cut -d: -f3)
                            awk -F: -v g="$_grp" -v nl="$_grp:x:$_gid:${_m}${USERNAME}" \
                                'BEGIN{OFS=":"} { if ($1==g) print nl; else print }' \
                                /etc/group > /etc/group.flx && mv /etc/group.flx /etc/group
                            ;;
                    esac
                fi
            done

            echo "$USERNAME:x:$UID_CAND:$GID_CAND:$REALNAME:/home/$USERNAME:/bin/sh" >> /etc/passwd
            echo "$USERNAME:$USERHASH:$SHA_DAYS:0:99999:7:::" >> /etc/shadow
            echo "  User '$USERNAME' (uid $UID_CAND) added. Home will be /home/$USERNAME"
            echo "  (persistent, on the FLX_HOME partition)."
        fi
        ;;
    *) echo "  Skipping user account creation." ;;
esac
echo ""

# --- Step 7: WiFi -----------------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 7/9 - WiFi"
echo "----------------------------------------------------------"
if [ -n "${WIFISSID:-}" ]; then
    MAKEWIFI="y"
else
    printf 'Configure a WiFi network? (y/N): '
    read -r MAKEWIFI || MAKEWIFI="n"
fi
case "$MAKEWIFI" in
    y|Y|yes|YES)
        echo "  Note: config is saved into the installed system and applied"
        echo "  at boot when a wireless card is present."
        if [ -z "${WIFISSID:-}" ]; then
            WIFISSID=$(ask_default "Enter WiFi SSID" "")
        fi
        if [ -n "$WIFISSID" ]; then
            if [ -z "${WIFIPASS:-}" ]; then
                printf 'Enter WiFi password (blank for open network): '
                read -r WIFIPASS || WIFIPASS=""
            fi
            mkdir -p /etc/wpa_supplicant
            if [ -n "$WIFIPASS" ] && command -v wpa_passphrase >/dev/null 2>&1; then
                wpa_passphrase "$WIFISSID" "$WIFIPASS" > /etc/wpa_supplicant/flxwifi.conf 2>/dev/null || {
                    printf 'network={\n ssid="%s"\n psk="%s"\n key_mgmt=WPA-PSK\n}\n' "$WIFISSID" "$WIFIPASS" > /etc/wpa_supplicant/flxwifi.conf
                }
            else
                printf 'network={\n ssid="%s"\n key_mgmt=NONE\n}\n' "$WIFISSID" > /etc/wpa_supplicant/flxwifi.conf
            fi
            chmod 600 /etc/wpa_supplicant/flxwifi.conf
            echo "  WiFi config saved for '$WIFISSID'."
            # Best effort: try to connect right away (ignored in QEMU tests)
            if command -v flxwifi >/dev/null 2>&1; then
                echo "  Trying to connect now (best effort)..."
                flxwifi connect "$WIFISSID" "$WIFIPASS" 2>/dev/null || true
            fi
        else
            echo "  Skipping WiFi (no SSID entered)."
        fi
        ;;
    *) echo "  Skipping WiFi configuration." ;;
esac
echo ""

# --- Step 8: Desktop environment ------------------------------------------------
echo "----------------------------------------------------------"
echo " Step 8/9 - Desktop environment"
echo "----------------------------------------------------------"
echo " FreeLinX philosophy: the base install is HEADLESS (CLI only)."
echo " Our full Openbox GUI (openbox + greetd login page + flx-session)"
echo " is baked into this offline image. Choose what to install:"
echo "   1) Headless (CLI terminal only, headless-first)"
echo "   2) GUI (Openbox + login page greets you after boot)"
printf "Install type (1=headless, 2=gui) [1]: "
if [ -z "${DI:-}" ]; then
    read -r DI || DI="1"
    [ -z "$DI" ] && DI="1"
else
    case "$DI" in
        2|2g|gui|GUI) : ;;
        1|1h|headless|HEADLESS) DI="1" ;;
    esac
    [ -z "$DI" ] && DI="1"
fi
case "$DI" in
    2) printf 'gui\n' > /etc/flx-desktop
       echo "  Desktop: GUI (Openbox). Login page will greet you after boot." ;;
    *) printf 'headless\n' > /etc/flx-desktop
       echo "  Desktop: Headless (CLI terminal only)." ;;
esac
echo ""

# ---------------------------------------------------------------------------
# --- Disk selection ----------------------------------------------------------
# ---------------------------------------------------------------------------
normalize_disk() {
    case "$1" in
        /dev/*) printf '%s' "$1" ;;
        *)      printf '/dev/%s' "$1" ;;
    esac
}

TARGET_DISK="${1:-${TARGET_DISK_PRESET:-}}"
if [ -n "$TARGET_DISK" ]; then
    TARGET_DISK="$(normalize_disk "$TARGET_DISK")"
fi

if [ -z "$TARGET_DISK" ]; then
    echo "----------------------------------------------------------"
    echo " Step 9/9 - Select target disk"
    echo "----------------------------------------------------------"
    echo " Available Block Storage Devices:"
    echo "--------------------------------------------------------------"
    i=1
    DISKS=""
    for blk in /sys/block/*; do
        devname=$(basename "$blk")
        case "$devname" in
            loop*|ram*|dm-*|sr*|zram*) continue ;;
        esac
        devpath="/dev/$devname"
        [ -b "$devpath" ] || continue
        size_sectors=$(cat "$blk/size" 2>/dev/null || echo 0)
        size_gb=$(awk "BEGIN {printf \"%.1f\", $size_sectors * 512 / 1073741824}")
        model="Unknown"
        if [ -r "$blk/device/model" ]; then
            model=$(cat "$blk/device/model" | tr -d '\r\n' | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
        fi
        echo "  [$i] $devpath  (${size_gb} GB - $model)"
        DISKS="$DISKS $devpath"
        i=$((i + 1))
    done
    echo "--------------------------------------------------------------"
    if [ -z "$DISKS" ]; then
        die "No installable block devices detected!"
    fi
    printf "Enter target disk (number, /dev/vda, or just vda): "
    read -r CHOICE || CHOICE=""
    idx=1
    for d in $DISKS; do
        if [ "$idx" = "$CHOICE" ]; then TARGET_DISK="$d"; break; fi
        idx=$((idx + 1))
    done
    if [ -z "$TARGET_DISK" ] && [ -b "$CHOICE" ]; then
        TARGET_DISK="$CHOICE"
    fi
    if [ -z "$TARGET_DISK" ]; then
        TARGET_DISK="$(normalize_disk "$CHOICE")"
    fi
fi

if [ -z "$TARGET_DISK" ] || [ ! -b "$TARGET_DISK" ]; then
    echo "Error: '$TARGET_DISK' is not a valid block device!" >&2
    echo "Use a number from the list, a full path like /dev/vda, or a bare name like vda." >&2
    exit 1
fi

echo ""
echo " WARNING: All data on $TARGET_DISK will be PERMANENTLY ERASED!"
if [ "${FLX_YES:-0}" = "1" ]; then
    CONFIRM="YES"
else
    printf " Type YES in capital letters to proceed: "
    read -r CONFIRM || CONFIRM="no"
fi
if [ "$CONFIRM" != "YES" ]; then
    echo " Installation cancelled."
    exit 0
fi

# --- Install phase -----------------------------------------------------------
# Quiesce the auto-mounter for the duration of the install.  flxautomount is
# triggered by mdevd the instant the new partitions appear and would mount
# them (e.g. /dev/vda1 -> /media/vda1, FLX_HOME -> /home) before we can
# format/mount them -> "Device or resource busy".  A flag file makes
# flxautomount step aside until we are done.
touch /run/flxinstall-active
trap 'rm -f /run/flxinstall-active' EXIT INT TERM

# Unmount anything already mounted from this disk (existing installs).
echo ""
echo "Unmounting existing partitions on $TARGET_DISK..."
for part in "${TARGET_DISK}"* "${TARGET_DISK}p"*; do
    if [ -b "$part" ]; then
        umount "$part" 2>/dev/null || :
    fi
done
# also drop automount points that belong to this disk (/media/<node>, /home)
TARGET_BASE=$(basename "$TARGET_DISK")
for m in /media/"$TARGET_BASE"* /home /mnt/flx_boot /mnt/flx_home; do
    if grep -qs " $m " /proc/mounts 2>/dev/null; then
        umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || :
    fi
done

echo ">>> Step 1/6: Partitioning $TARGET_DISK with flxpart (GPT)..."
# ESP (512MB FAT32) + BIOS Boot (1MB) + FLX_SYS (persistent /usr /etc /var /root)
# + Linux Home partition (remainder).
flxpart --create-standard "$TARGET_DISK"
command -v partprobe >/dev/null 2>&1 && partprobe "$TARGET_DISK" 2>/dev/null || :
sleep 1

case "$TARGET_DISK" in
    *[0-9])
        PART1="${TARGET_DISK}p1"; PART2="${TARGET_DISK}p2"; PART3="${TARGET_DISK}p3"; PART4="${TARGET_DISK}p4" ;;
    *)
        PART1="${TARGET_DISK}1"; PART2="${TARGET_DISK}2"; PART3="${TARGET_DISK}3"; PART4="${TARGET_DISK}4" ;;
esac

timeout=10
while [ ! -b "$PART1" ] || [ ! -b "$PART4" ]; do
    sleep 0.5
    timeout=$((timeout - 1))
    [ "$timeout" -le 0 ] && break
done
if [ ! -b "$PART1" ] || [ ! -b "$PART4" ]; then
    die "Partition device nodes ($PART1 .. $PART4) not found after partitioning."
fi

echo ">>> Step 2/6: Formatting Filesystems..."
umount "$PART1" 2>/dev/null || :
umount "$PART3" 2>/dev/null || :
umount "$PART4" 2>/dev/null || :
echo "Formatting ESP partition ($PART1) as FAT32..."
$MKFS_FAT -F 32 -n "FLX_BOOT" "$PART1" >/dev/null
echo "Formatting System partition ($PART3) as Ext4 (LABEL=FLX_SYS)..."
$MKFS_EXT4 -F -q -L "FLX_SYS" "$PART3"
echo "Formatting Home partition ($PART4) as Ext4 (LABEL=FLX_HOME)..."
$MKFS_EXT4 -F -q -L "FLX_HOME" "$PART4"

echo ">>> Step 3/6: Mounting ESP..."
BOOT_DIR="/mnt/flx_boot"
mkdir -p "$BOOT_DIR"
umount "$PART1" 2>/dev/null || :
mount -t vfat "$PART1" "$BOOT_DIR" || toybox mount -t vfat "$PART1" "$BOOT_DIR"
mkdir -p "$BOOT_DIR/boot" "$BOOT_DIR/EFI/BOOT"

echo ">>> Step 4/6: Deploying FreeLinX (kernel + initramfs, incl. config)..."
KERNEL_SRC=""
for k in /boot/bzImage /boot/vmlinuz /kernel/bzImage /initramfs/bzImage /vmlinuz; do
    if [ -f "$k" ]; then KERNEL_SRC="$k"; break; fi
done
if [ -n "$KERNEL_SRC" ]; then
    echo "Installing kernel from $KERNEL_SRC..."
    cp "$KERNEL_SRC" "$BOOT_DIR/boot/bzImage"
else
    echo "Error: FreeLinX kernel not found in live environment." >&2
    umount "$BOOT_DIR"; exit 1
fi

INITRD_SRC=""
for i in /boot/initramfs.img.gz /initramfs.img.gz /boot/freelinx-desktop.img.gz; do
    if [ -f "$i" ]; then INITRD_SRC="$i"; break; fi
done

# Mark this system as installed (not live ISO).  /init only engages the
# FLX_SYS persistent overlay when this marker is present, so the live ISO
# never picks up a stale FLX_SYS partition from an attached disk.
touch /etc/flx-installed 2>/dev/null || :

if [ -n "$INITRD_SRC" ]; then
    echo "Installing initramfs (full OS) from $INITRD_SRC..."
    cp "$INITRD_SRC" "$BOOT_DIR/boot/initramfs.img.gz"
    # Bake the installed-system marker into the copied image as well (the
    # kernel unpacks trailing concatenated cpio archives).
    (cd / && find ./etc/flx-installed -print0 2>/dev/null \
        | cpio --null -ov --format=newc 2>/dev/null \
        >> "$BOOT_DIR/boot/initramfs.img.gz") 2>/dev/null || :
else
    echo "Repacking live rootfs into initramfs (config baked in)..."
    if command -v cpio >/dev/null 2>&1 && command -v gzip >/dev/null 2>&1; then
        (cd / && find . -xdev \
            -not -path './proc/*' -not -path './sys/*' \
            -not -path './dev/*'  -not -path './run/*' \
            -not -path './tmp/*'  -not -path './mnt/*' \
            -not -path './media/*' -not -path './home/*' \
            -print0 2>/dev/null | cpio --null -ov --format=newc 2>/dev/null \
            | gzip -1 > "$BOOT_DIR/boot/initramfs.img.gz") || {
            echo "Error: failed to repack initramfs." >&2
            umount "$BOOT_DIR"; exit 1
        }
    else
        echo "Error: no initramfs image and no cpio/gzip to repack one." >&2
        umount "$BOOT_DIR"; exit 1
    fi
fi

echo ">>> Seeding persistent system partition (FLX_SYS)..."
# Copy the live /usr /etc /var /root trees onto the FLX_SYS partition
# (ext4, LABEL=FLX_SYS).  On every boot /init bind-mounts these trees from
# FLX_SYS so xpkg-installed packages, config and state survive reboots.
SYS_MP="/mnt/flx_sys"
mkdir -p "$SYS_MP"
umount "$PART3" 2>/dev/null || :
mount -t ext4 "$PART3" "$SYS_MP" 2>/dev/null || mount "$PART3" "$SYS_MP" 2>/dev/null || true
if grep -qs " $SYS_MP " /proc/mounts 2>/dev/null; then
    for d in usr etc var root; do
        mkdir -p "$SYS_MP/$d"
        if [ -z "$(ls -A "$SYS_MP/$d" 2>/dev/null)" ]; then
            echo "  seeding /$d -> FLX_SYS ..."
            # tar is used instead of cp -a: toybox cp -a cannot copy
            # symlink trees (e.g. /root/.config/openbox/* -> /etc/xdg/...)
            # without erroring out, which previously left /var and /root
            # unseeded and made the system RAM-only after reboot.
            if command -v tar >/dev/null 2>&1; then
                (cd / && tar cf - "$d" 2>/dev/null) | (cd "$SYS_MP" && tar xf - 2>/dev/null) \
                    || echo "  warning: seeding /$d failed (system will stay RAM-only)."
            else
                echo "  warning: tar missing - skipping seed of /$d."
            fi
        else
            echo "  /$d already populated on FLX_SYS (kept)."
        fi
    done
else
    echo "  Warning: could not mount FLX_SYS ($PART3) to seed persistent trees."
fi

echo ">>> Step 5/6: Configuring Bootloader (Limine UEFI + BIOS)..."
if [ -d "$LIMINE_DIR" ]; then
    if [ -f "$LIMINE_DIR/BOOTX64.EFI" ]; then
        cp "$LIMINE_DIR/BOOTX64.EFI" "$BOOT_DIR/EFI/BOOT/BOOTX64.EFI"
        cp "$LIMINE_DIR/BOOTX64.EFI" "$BOOT_DIR/BOOTX64.EFI"
    else
        echo "Warning: $LIMINE_DIR/BOOTX64.EFI not found; UEFI may be unavailable."
    fi
    if [ -f "$LIMINE_DIR/limine-bios.sys" ]; then
        cp "$LIMINE_DIR/limine-bios.sys" "$BOOT_DIR/boot/limine-bios.sys"
        cp "$LIMINE_DIR/limine-bios.sys" "$BOOT_DIR/limine-bios.sys"
    fi
else
    echo "Warning: Limine files not found in $LIMINE_DIR."
fi
if command -v limine >/dev/null 2>&1; then
    echo "Deploying Limine BIOS stage to $TARGET_DISK (BIOS Boot $PART2)..."
    limine bios-install "$TARGET_DISK" 2 || echo "Warning: limine bios-install failed; UEFI still works."
fi

cat > "$BOOT_DIR/limine.conf" << EOF
timeout: 5
serial: yes

/FreeLinX (Initramfs Desktop)
    protocol: linux
    kernel_path: boot():/boot/bzImage
    module_path: boot():/boot/initramfs.img.gz
    cmdline: rdinit=/init console=tty0 console=ttyS0,115200 quiet loglevel=2

/FreeLinX (Rescue Shell)
    protocol: linux
    kernel_path: boot():/boot/bzImage
    module_path: boot():/boot/initramfs.img.gz
    cmdline: rdinit=/init flx.rescue=1 console=tty0 console=ttyS0,115200 quiet loglevel=2
EOF
cp "$BOOT_DIR/limine.conf" "$BOOT_DIR/boot/limine.conf"
cp "$BOOT_DIR/limine.conf" "$BOOT_DIR/EFI/BOOT/limine.conf"

echo ">>> Step 6/6: Persistence (FLX_HOME) and user home..."
# If a user account was configured, create its home on the persistent
# FLX_HOME partition so it survives reboots.
if [ -n "$USERNAME" ] && [ -b "$PART4" ]; then
    HOME_MP="/mnt/flx_home"
    mkdir -p "$HOME_MP"
    mount -t ext4 "$PART4" "$HOME_MP" 2>/dev/null || mount "$PART4" "$HOME_MP" 2>/dev/null || true
    if grep -qs " $HOME_MP " /proc/mounts 2>/dev/null; then
        mkdir -p "$HOME_MP/$USERNAME"
        # minimal skeleton
        cat > "$HOME_MP/$USERNAME/.profile" << EOF
# FreeLinX user profile (created by flxinstall)
export PATH=/usr/share/X11/xtree/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
[ -r /etc/flx-locale ] && export LANG="\$(cat /etc/flx-locale)"
[ -r /etc/flx-locale ] && export LC_ALL="\$(cat /etc/flx-locale)"
[ -r /etc/TZ ] && export TZ="\$(cat /etc/TZ)"
EOF
        chown -R "${UID_CAND}:${GID_CAND}" "$HOME_MP/$USERNAME" 2>/dev/null || :
        umount "$HOME_MP"
        rmdir "$HOME_MP" 2>/dev/null || :
        echo "  Created persistent home for '$USERNAME' on FLX_HOME."
    else
        echo "  Warning: could not mount FLX_HOME to seed user home."
    fi
fi

echo "Syncing data to disk..."
sync
umount "$BOOT_DIR"
rmdir "$BOOT_DIR" 2>/dev/null || :

rm -f /run/flxinstall-active
trap - EXIT INT TERM

echo ""
echo "=========================================================="
echo " FreeLinX installed to $TARGET_DISK!"
echo " Boot model: Initramfs-primary + FLX_SYS persistent system."
echo "=========================================================="
[ -n "$USERNAME" ] && echo " User account : $USERNAME  (home on $PART4)"
echo " System       : FLX_SYS ($PART3) - /usr /etc /var /root persist"
echo " Hostname     : $HOSTNAME"
echo " Language     : $LANG_LC"
echo " Keyboard     : $KBD_LAYOUT"
echo " Timezone     : $TZ_STR"
echo ""
DESK_MODE="$(cat /etc/flx-desktop 2>/dev/null || echo headless)"
echo ""
echo " REBOOT NOW: quit this live system (Ctrl-Alt-Del or power off),"
echo " remove the live media, and boot from the installed disk."
if [ "$DESK_MODE" = "gui" ]; then
    echo " Your FreeLinX GUI desktop is installed - the greetd login page"
    echo " (tuigreet) will greet you after boot. Enter your password and the"
    echo " desktop greets you."
else
    echo " Your FreeLinX HEADLESS system is installed - booting goes"
    echo " straight to a root terminal (headless-first). You can pull the"
    echo " GUI (openbox + greetd login page) later from the FreeLinX repo."
fi
echo ""