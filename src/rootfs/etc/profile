# FreeLinX System Profile
export PATH=/usr/share/X11/xtree/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
export TERM=xterm-256color
export SHELL=/bin/sh

_UID=$(id -u 2>/dev/null || echo 0)
if [ "$_UID" -eq 0 ]; then
    export USER=root
    export LOGNAME=root
    export HOME=/root
    export PS1="root@freelinx:~# "
else
    _UNAME=$(id -un 2>/dev/null || whoami 2>/dev/null || echo user)
    export USER="$_UNAME"
    export LOGNAME="$_UNAME"
    export HOME="/home/$_UNAME"
    export PS1="$_UNAME@freelinx:~$ "
fi
unset _UID _UNAME

HOSTNAME=$(cat /etc/hostname 2>/dev/null || echo freelinx)
export HOSTNAME
export ENV=/etc/profile

# Fontconfig and X11 overrides for statically linked apps
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
export FONTCONFIG_PATH=/etc/fonts

# X11 locale database (statically linked libX11 looks here first via XLOCALEDIR;
# its compiled-in default points at the build machine's path and never exists here)
export XLOCALEDIR=/usr/share/X11/locale

# Full English Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8



# FreeLinX Installer overrides (written by flxinstall into the live rootfs;
# baked into the initramfs at install time).
[ -r /etc/flx-lang ] && export LANG="$(cat /etc/flx-lang)"
[ -r /etc/flx-lang ] && export LC_ALL="$(cat /etc/flx-lang)"
[ -r /etc/flx-kbd ] && export FLX_KBD="$(cat /etc/flx-kbd)"
[ -r /etc/TZ ] && export TZ="$(cat /etc/TZ)"
