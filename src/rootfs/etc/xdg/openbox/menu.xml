  <item label="fterm">
    <action name="Execute"><command>fterm</command></action>
  </item>
  <item label="xfce4-terminal">
    <action name="Execute"><command>xfce4-terminal</command></action>
  </item>
</menu>

<menu id="text-menu" label="Text" />
