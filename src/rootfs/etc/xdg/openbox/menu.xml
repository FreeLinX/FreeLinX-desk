<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="accessibility-menu" label="Accessibility">
  <item label="Xmag">
    <action name="Execute"><command>xmag</command></action>
  </item>
</menu>

<menu id="editors-menu" label="Editors">
  <item label="Vim">
    <action name="Execute"><command>fterm -e vim</command></action>
  </item>
  <item label="Nano">
    <action name="Execute"><command>fterm -e nano</command></action>
  </item>
</menu>

<menu id="education-menu" label="Education" />
<menu id="emulators-menu" label="Emulators" />

<menu id="file-management-menu" label="File Management">
  <item label="FreeLinX Files">
    <action name="Execute"><command>fview</command></action>
  </item>
  <item label="Thunar">
    <action name="Execute"><command>thunar</command></action>
  </item>
</menu>

<menu id="graphics-menu" label="Graphics" />

<menu id="network-menu" label="Network">
  <item label="w3m Web Browser">
    <action name="Execute"><command>fterm -e w3m google.com</command></action>
  </item>
</menu>

<menu id="office-menu" label="Office" />
<menu id="programming-menu" label="Programming" />
<menu id="science-menu" label="Science" />

<menu id="shells-menu" label="Shells">
