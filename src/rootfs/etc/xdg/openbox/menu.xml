</menu>

<menu id="wm-menu" label="Window Managers">
  <item label="Openbox">
    <action name="Restart"><command>openbox</command></action>
  </item>
</menu>

<menu id="debian-menu" label="Debian">
  <menu id="applications-menu" />
  <menu id="games-menu" />
  <item label="Help">
    <action name="Execute"><command>fterm -e man openbox</command></action>
  </item>
  <menu id="wm-menu" />
</menu>

<menu id="root-menu" label="Openbox">
  <item label="Terminal emulator">
    <action name="Execute">
      <command>uxterm</command>
      <startupnotify><enabled>yes</enabled></startupnotify>
    </action>
  </item>

  <item label="Web browser">
    <action name="Execute">
      <command>x-www-browser</command>
      <startupnotify><enabled>yes</enabled></startupnotify>
    </action>
  </item>

  <separator />

  <menu id="debian-menu" />

  <menu id="client-list-combined-menu" label="Desktops" />

  <item label="ObConf">
    <action name="Execute">
      <command>obconf</command>
    </action>
  </item>

  <item label="Reconfigure">
    <action name="Reconfigure" />
  </item>

  <item label="Restart">
    <action name="Restart" />
  </item>

  <item label="Exit">
    <action name="Exit">
      <prompt>yes</prompt>
    </action>
  </item>
