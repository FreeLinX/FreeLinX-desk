  </item>
</menu>

<menu id="sound-menu" label="Sound" />

<menu id="system-app-menu" label="System">
  <item label="System Info (pfetch)">
    <action name="Execute"><command>fterm -e sh -c "pfetch; echo ''; echo 'Press Enter to close...'; read l"</command></action>
  </item>
  <item label="Window Info (obxprop)">
    <action name="Execute"><command>fterm -e sh -c "echo 'Click on any window to inspect:'; obxprop; echo ''; echo 'Press Enter to close...'; read l"</command></action>
  </item>
</menu>

<menu id="terminal-emulators-menu" label="Terminal Emulators">
  <item label="uxterm">
    <action name="Execute"><command>uxterm</command></action>
