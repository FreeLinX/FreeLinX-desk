#!/bin/sh
# Bluetooth daemon (bluez). Adapters that appear later (USB dongles) are
# picked up by bluetoothd itself through the kernel mgmt interface.
[ -x /usr/libexec/bluetooth/bluetoothd ] || exec sleep 86400
# needs the system bus (served by the dbus service)
i=0
while [ ! -S /run/dbus/system_bus_socket ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
modprobe btusb 2>/dev/null || :
mkdir -p /var/lib/bluetooth
exec /usr/libexec/bluetooth/bluetoothd -n 2>&1
