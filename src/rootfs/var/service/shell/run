#!/bin/sh
# Serial console on ttyS1. The live ISO gives a root shell for debugging;
# an installed system (/etc/flx-installed) asks for a login instead.
# If ttyS1 does not exist, idle quietly instead of respawning every second.
[ -e /dev/ttyS1 ] || exec sleep 86400
if [ -e /etc/flx-installed ]; then
    # getty sets up the controlling terminal; toybox login checks /etc/shadow.
    exec /usr/bin/getty -l /usr/libexec/toybox/login 115200 ttyS1 vt100
fi
exec /bin/sh -l < /dev/ttyS1 > /dev/ttyS1 2>&1
