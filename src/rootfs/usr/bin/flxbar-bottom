#!/bin/sh
# flxbar-bottom: minimal bottom status bar fed by i3status.
# lemonbar-xft: fontconfig fonts, docked cleanly at the bottom edge (-b).

export DISPLAY="${DISPLAY:-:0}"
export FONTCONFIG_PATH=/etc/fonts
export FONTCONFIG_FILE=/etc/fonts/fonts.conf

BG=$(cat /tmp/.flxbg 2>/dev/null)
[ -z "$BG" ] && BG="#778877"

case "$BG" in
    *"#24272e"*|*"#3a4a58"*|*"#1e"*|*"#20"*|*"#2e"*)
        FG="#e0e0e0"
        ;;
    *)
        FG="#111111"
        ;;
esac

BH=20
WIDTH=$(xrandr --current 2>/dev/null | grep -E '\bconnected\b' | grep -oE '[0-9]+x[0-9]+' | head -1 | cut -d x -f1)
[ -z "$WIDTH" ] && WIDTH=1280

i3status -c /etc/i3status.conf 2>/dev/null | while IFS= read -r line; do
    echo "%{l}  FreeLinX %{r}${line} "
done | lemonbar -b -p -g "${WIDTH}x${BH}+0+0" -f "DejaVu Sans:size=9" -F "$FG" -B "$BG"