#!/bin/sh
# FreeLinX YouTube Player & Searcher (MPV + Invidious API)
set -e

INVIDIOUS_INSTANCES="https://inv.nadeko.net https://yewtu.be https://invidious.nerdvpn.de"

usage() {
    echo "FreeLinX YouTube Client (via MPV + Hardware Acceleration)"
    echo "Usage:"
    echo "  flx-yt <search terms>      - Search YouTube and play selected video"
    echo "  flx-yt <youtube_url>       - Play YouTube video directly in MPV"
    echo "  flx-yt                     - Interactive search prompt"
    exit 1
}

play_url() {
    URL="$1"
    echo "==> Streaming via MPV: $URL"
    exec mpv "$URL"
}

if [ $# -eq 1 ] && (echo "$1" | grep -q -E '^https?://'); then
    play_url "$1"
fi

QUERY="$*"
if [ -z "$QUERY" ]; then
    printf "Enter YouTube search query: "
    read -r QUERY
fi

if [ -z "$QUERY" ]; then
    usage
fi

ENCODED_QUERY=$(echo "$QUERY" | tr ' ' '+')

echo "Searching YouTube for: $QUERY ..."

RESULTS=""
for INST in $INVIDIOUS_INSTANCES; do
    RESULTS=$(curl -s --connect-timeout 4 "${INST}/api/v1/search?q=${ENCODED_QUERY}&type=video" 2>/dev/null || true)
    if [ -n "$RESULTS" ] && echo "$RESULTS" | grep -q '"videoId"'; then
        API_HOST="$INST"
        break
    fi
done

if [ -z "$RESULTS" ] || ! echo "$RESULTS" | grep -q '"videoId"'; then
    echo "Error: Unable to connect to search gateway. You can still play directly via URL:"
    echo "  flx-yt https://www.youtube.com/watch?v=VIDEO_ID"
    exit 1
fi

echo ""
echo "=== Search Results ==="
# Parse titles and videoIds using basic POSIX tools
VIDEO_IDS=$(echo "$RESULTS" | grep -o '"videoId":"[^"]*"' | cut -d'"' -f4 | head -n 10)
TITLES=$(echo "$RESULTS" | grep -o '"title":"[^"]*"' | cut -d'"' -f4 | head -n 10)

NUM=1
echo "$VIDEO_IDS" | while read -r VID; do
    TITLE=$(echo "$TITLES" | sed -n "${NUM}p")
    echo "[$NUM] $TITLE"
    NUM=$((NUM + 1))
done

echo ""
printf "Enter video number [1-10] (or 0 to cancel): "
read -r CHOICE

if [ -z "$CHOICE" ] || [ "$CHOICE" -eq 0 ] 2>/dev/null; then
    echo "Cancelled."
    exit 0
fi

SELECTED_VID=$(echo "$VIDEO_IDS" | sed -n "${CHOICE}p")
if [ -z "$SELECTED_VID" ]; then
    echo "Invalid selection."
    exit 1
fi

VIDEO_URL="https://www.youtube.com/watch?v=${SELECTED_VID}"
play_url "$VIDEO_URL"
