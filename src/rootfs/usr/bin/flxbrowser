#!/bin/sh
# FreeLinX Browser Launcher (non-GNU)
# Firefox (full JavaScript) under X11; Dillo as the light fallback; Links,
# w3m or lynx in a console.  TLS certificates are always verified.

# No local welcome page ships with the release rootfs (removed by design);
# default to a lightweight search page when no URL is given.
HOMEPAGE="https://duckduckgo.com/lite/"
URL="${1:-$HOMEPAGE}"

if [ -n "${DISPLAY:-}" ]; then
    if [ -x /usr/lib/firefox/firefox ]; then
        if [ $# -gt 0 ]; then exec /usr/lib/firefox/firefox "$@"; fi
        exec /usr/lib/firefox/firefox
    elif [ -x /usr/bin/dillo ]; then
        exec /usr/bin/dillo "$URL"
    fi
fi

if [ -x /usr/bin/links ]; then
    exec /usr/bin/links "$URL"
elif [ -x /usr/bin/lynx ]; then
    exec /usr/bin/lynx "$URL"
elif [ -x /usr/bin/w3m ]; then
    exec /usr/bin/w3m "$URL"
fi
