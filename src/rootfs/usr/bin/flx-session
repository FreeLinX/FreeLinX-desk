#!/bin/sh
# FreeLinX X11 desktop: start Xorg via modesetting (DRM/KMS) or fbdev fallback.

# Apply what flxinstall baked in: locale and timezone.  Exporting here means
# every X client inherited from this session sees the user's choices.
for _f in /etc/flx-locale /etc/flx-lang; do
    if [ -r "$_f" ]; then
        export LANG="$(cat "$_f")"
        export LC_ALL="$LANG"
        break
    fi
done
if [ -r /etc/TZ ]; then
    export TZ="$(cat /etc/TZ)"
fi

# Per-user runtime dir (sockets, dconf, pulse/pipewire-style state).
_rt="/run/user/$(id -u)"
if mkdir -p -m 0700 "$_rt" 2>/dev/null && [ -O "$_rt" ]; then
    export XDG_RUNTIME_DIR="$_rt"
fi

FLX_LOG=/dev/null
case "$(cat /proc/cmdline 2>/dev/null)" in
    # Only when writable: a user session (greetd) cannot open ttyS0, and a
    # failed redirection makes sh skip the command - Xorg would never start.
    *console=ttyS0*) [ -c /dev/ttyS0 ] && [ -w /dev/ttyS0 ] && FLX_LOG=/dev/ttyS0 ;;
esac

mkdir -p /tmp/.X11-unix /var/lib/xkb 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# Kill any leftover Xorg/openbox from a previous runit cycle so the new
# service never fights stale processes (lock, WM, or device handles).
for p in /proc/[0-9]*; do
    [ -r "$p/cmdline" ] || continue
    cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
    case "$cmd" in
        *"Xorg"*|*"openbox"*) kill -9 "${p#/proc/}" 2>/dev/null || true ;;
    esac
done

# Never let a previous incarnation hold the display lock.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0

# Input devices: Xorg finds and hot-plugs them itself (udev backend over
# libudev-zero, libinput driver).
if [ ! -e /dev/fb0 ]; then mknod /dev/fb0 c 29 0 2>/dev/null || true; fi
if [ -e /dev/fb0 ]; then
    chmod 666 /dev/fb0 2>/dev/null || true
    echo "FreeLinX: Framebuffer ready: $(ls /dev/fb* 2>/dev/null)" > "$FLX_LOG"
fi


# Driver choice:
#   i915, nouveau, amdgpu, radeon
#                            -> modesetting + glamor (hardware Mesa driver:
#                               iris/crocus/i915, nouveau, radeonsi, r600/r300)
#   other KMS drivers        -> modesetting, CPU shadow (virtio-gpu has no
#                               virgl renderer here)
#   firmware framebuffer     -> fbdev + ShadowFB (simpledrm, "basic graphics")
# flx.xdriver=fbdev|kms|glamor on the kernel command line overrides it.
XCONF=xorg.conf
_kms=""
for _c in /sys/class/drm/card[0-9]; do
    [ -e "$_c/device" ] || continue
    _kms=$(basename "$(readlink "$_c/device/driver" 2>/dev/null)" 2>/dev/null)
    break
done
case "$_kms" in
    ""|simple-framebuffer|simpledrm|efi-framebuffer|vesa-framebuffer) ;;
    i915|nouveau|amdgpu|radeon) XCONF=xorg-modesetting.conf ;;
    *) XCONF=xorg-kms.conf ;;
esac
case " $(cat /proc/cmdline 2>/dev/null) " in
    *" flx.xdriver=fbdev "*) XCONF=xorg.conf ;;
    *" flx.xdriver=kms "*) XCONF=xorg-kms.conf ;;
    *" flx.xdriver=glamor "*|*" flx.xdriver=modesetting "*) XCONF=xorg-modesetting.conf ;;
esac

if [ "$(id -u)" = 0 ]; then
    Xorg -config "$XCONF" -noreset -nolisten tcp -logfile /tmp/xorg.log > "$FLX_LOG" 2>&1 &
else
    # A user session (greetd): Xorg is setuid root and then refuses absolute
    # -config/-logfile paths; a bare name is looked up in /etc/X11.  The log
    # goes to ~/.local/share/xorg/.  Run on greetd's VT.
    mkdir -p "$HOME/.local/share/xorg"
    Xorg ":0" "vt${XDG_VTNR:-1}" -config "$XCONF" -keeptty -noreset -nolisten tcp > "$FLX_LOG" 2>&1 &
fi
XPID=$!

i=0
while [ ! -e /tmp/.X11-unix/X0 ] && kill -0 "$XPID" 2>/dev/null && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i+1))
done

if [ ! -e /tmp/.X11-unix/X0 ]; then
    echo "=== Xorg failed to start on :0 ===" > "$FLX_LOG"
    echo "=== /dev/fb* ===" > "$FLX_LOG"
    ls -la /dev/fb* /dev/dri/* > "$FLX_LOG" 2>&1 || true
    echo "=== dmesg DRM/FB ===" > "$FLX_LOG"
    dmesg | grep -i -E "drm|fb|virtio" > "$FLX_LOG" 2>&1 || true
    echo "=== /tmp/xorg.log ===" > "$FLX_LOG"
    cat /tmp/xorg.log > "$FLX_LOG" 2>&1 || true
    exit 1
fi

echo "=== Xorg Full Log ===" > "$FLX_LOG"
cat /tmp/xorg.log > "$FLX_LOG" 2>&1 || true

export DISPLAY=:0
export XLOCALEDIR=/usr/share/X11/locale
# When greeted by greetd after a real login, run the desktop AS the logged-in
# user (greetd/PAM provide $USER, $HOME).  Without a login context (live
# autologin / runit-as-root), fall back to the root session.
: "${USER:=root}"
: "${HOME:=/root}"
export USER HOME
export ENV=/etc/profile
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
mkdir -p "$XDG_CONFIG_HOME/openbox"

# Run the openbox desktop shell. Its rc.xml binds W-p / A-F2 to dmenu_run;
# dwm remains the fallback if openbox is ever missing so the desktop never
# comes up dead (slstatus feeds the dwm bar when dwm runs).
if [ -x /usr/bin/openbox ]; then
    ( exec /usr/bin/openbox --startup "/usr/lib/openbox/openbox-autostart OPENBOX" 2>&1 | tee -a /tmp/openbox.log > "$FLX_LOG" ) &
else
    if [ -x /usr/bin/slstatus ]; then
        /usr/bin/slstatus 2>/dev/null >/dev/null &
    fi
    ( exec /usr/bin/dwm 2>&1 | tee -a /tmp/dwm.log > "$FLX_LOG" ) &
fi
wait "$XPID"
exit 0
