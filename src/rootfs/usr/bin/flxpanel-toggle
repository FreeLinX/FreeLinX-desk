#!/bin/sh
# flxpanel-toggle: Toggle the FreeLinX desktop panel (add if missing, delete if present)

export DISPLAY="${DISPLAY:-:0}"

# proc alive-and-not-a-zombie check (zombies keep their comm name but can't
# render; ignoring them lets the panel reappear on the next toggle)
proc_live() {
    p="$1"
    read -r st < "$p/stat" 2>/dev/null || return 1
    st="${st##*') '}"   # state is the char right after the last ") "
    case "$st" in
        Z*) return 1 ;;
        *)  return 0 ;;
    esac
}

is_running=0
for c in /proc/[0-9]*/comm; do
    [ -f "$c" ] || continue
    read -r name < "$c" 2>/dev/null || continue
    if [ "$name" = "lemonbar" ] && proc_live "${c%/comm}"; then
        is_running=1
        break
    fi
done

if [ "$is_running" -eq 1 ]; then
    /usr/bin/flxpanel-del
else
    /usr/bin/flxpanel-add
fi
