diff -ru a/alsamixer/bindings.h b/alsamixer/bindings.h
--- a/alsamixer/bindings.h	2024-11-12 13:36:54.000000000 +0400
+++ b/alsamixer/bindings.h	2026-10-02 00:35:09.289928295 +0400
@@ -59,20 +59,35 @@
 	CMD_MIXER_MOUSE_CLICK_CONTROL_ENUM,
 };
 
+/* FreeLinX: NetBSD curses numbers the menu requests from REQ_BASE_NUM
+ * (KEY_MAX + 0x200) and has no MIN_/MAX_MENU_COMMAND; relative to that base
+ * they still fit in 8 bits. */
+#ifdef REQ_BASE_NUM
+#define CMD_MENU_BASE REQ_BASE_NUM
+#else
+#define CMD_MENU_BASE KEY_MAX
+#endif
+#ifndef MIN_MENU_COMMAND
+#define MIN_MENU_COMMAND REQ_LEFT_ITEM
+#endif
+#ifndef MAX_MENU_COMMAND
+#define MAX_MENU_COMMAND REQ_PREV_MATCH
+#endif
+
 enum textbox_command {
 	/* Since these commands are also used by the menu widget we make use of
 	 * the menu_driver() request constants.
 	 * KEY_MAX is substracted so the value fits in 8 bits. */
-	CMD_TEXTBOX___MIN_MENU_COMMAND = MIN_MENU_COMMAND - KEY_MAX,
-	CMD_TEXTBOX_TOP = REQ_FIRST_ITEM - KEY_MAX,
-	CMD_TEXTBOX_BOTTOM = REQ_LAST_ITEM - KEY_MAX,
-	CMD_TEXTBOX_LEFT = REQ_LEFT_ITEM - KEY_MAX,
-	CMD_TEXTBOX_RIGHT = REQ_RIGHT_ITEM - KEY_MAX,
-	CMD_TEXTBOX_UP = REQ_UP_ITEM - KEY_MAX,
-	CMD_TEXTBOX_DOWN = REQ_DOWN_ITEM - KEY_MAX,
-	CMD_TEXTBOX_PAGE_DOWN = REQ_SCR_DPAGE - KEY_MAX,
-	CMD_TEXTBOX_PAGE_UP = REQ_SCR_UPAGE - KEY_MAX,
-	CMD_TEXTBOX___MAX_MENU_COMMAND = MAX_MENU_COMMAND - KEY_MAX,
+	CMD_TEXTBOX___MIN_MENU_COMMAND = MIN_MENU_COMMAND - CMD_MENU_BASE,
+	CMD_TEXTBOX_TOP = REQ_FIRST_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_BOTTOM = REQ_LAST_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_LEFT = REQ_LEFT_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_RIGHT = REQ_RIGHT_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_UP = REQ_UP_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_DOWN = REQ_DOWN_ITEM - CMD_MENU_BASE,
+	CMD_TEXTBOX_PAGE_DOWN = REQ_SCR_DPAGE - CMD_MENU_BASE,
+	CMD_TEXTBOX_PAGE_UP = REQ_SCR_UPAGE - CMD_MENU_BASE,
+	CMD_TEXTBOX___MAX_MENU_COMMAND = MAX_MENU_COMMAND - CMD_MENU_BASE,
 	CMD_TEXTBOX_PAGE_LEFT,
 	CMD_TEXTBOX_PAGE_RIGHT,
 	CMD_TEXTBOX_CLOSE,
diff -ru a/alsamixer/menu_widget.c b/alsamixer/menu_widget.c
--- a/alsamixer/menu_widget.c	2024-11-12 13:36:54.000000000 +0400
+++ b/alsamixer/menu_widget.c	2026-10-02 00:35:09.289928295 +0400
@@ -55,7 +55,7 @@
 			key = textbox_bindings[key];
 			if (key >= CMD_TEXTBOX___MIN_MENU_COMMAND &&
 					key <= CMD_TEXTBOX___MAX_MENU_COMMAND)
-				menu_driver(menu, key + KEY_MAX);
+				menu_driver(menu, key + CMD_MENU_BASE);
 		}
 
 		return -1;
